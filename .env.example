# Rodchat : hébergement Vercel + Neon uniquement (aucun autre service).

# --- Base de données Neon -----------------------------------------------
# Copie les deux chaînes depuis le tableau de bord Neon (bouton "Connect").
# DATABASE_URL : connexion poolée (host avec "-pooler"), utilisée par l'application.
# DIRECT_URL   : connexion directe (sans "-pooler"), utilisée par "prisma db push".
# Sur Vercel, ajoute "&pgbouncer=true&connect_timeout=15" à DATABASE_URL (chaque requête ouvre sa propre connexion).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Authentification ---------------------------------------------------
# Génère une valeur avec : openssl rand -base64 32
AUTH_SECRET=""

# --- Inscription sur invitation (facultatif) ----------------------------
# Si tu définis un code, il faut le connaître pour créer un compte. Laisse vide pour une inscription ouverte.
# Tu peux aussi partager un lien qui remplit le champ : https://ton-site.vercel.app/register?code=TON_CODE
INVITE_CODE=""

# --- Modération et mentions légales ----------------------------------------
# Administrateurs (noms d'utilisateur, séparés par des virgules) : ils accèdent à l'espace /admin.
# Crée d'abord un compte normal dans l'application, puis mets ici son nom d'utilisateur.
ADMIN_USERNAMES=""
# Adresse affichée dans les pages « Conditions » et « Confidentialité » pour les demandes des utilisateurs.
NEXT_PUBLIC_CONTACT_EMAIL=""

# --- Stockage (facultatif) -----------------------------------------------
# Espace total de ta base en Mo (512 = offre gratuite de Neon) et part réservée aux photos, vidéos, vocaux et fichiers.
# Quand les médias atteignent 90 % de leur part, les plus anciens sont supprimés automatiquement.
STORAGE_QUOTA_MB="512"
STORAGE_MEDIA_BUDGET_MB="358"

# --- Tâche planifiée (Vercel) ---------------------------------------------
# Secret du nettoyage quotidien (/api/cron/purge) ; Vercel l'envoie tout seul. Génère-le avec : openssl rand -hex 32
CRON_SECRET=""

# --- Notifications push (facultatif) -------------------------------------
# Génère les clés avec : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:toi@exemple.com"

# --- Fichiers et vocaux ----------------------------------------------------
# Tout est stocké dans PostgreSQL. Vercel refuse les envois de plus de 4,5 Mo : la limite est réglée à 4 Mo
# sur Vercel et 10 Mo en local. Pour la baisser : NEXT_PUBLIC_MAX_UPLOAD_MB="2"

# --- Appels audio et vidéo ---------------------------------------------------
# Le serveur STUN public de Google est utilisé par défaut. Certains réseaux (mobile, entreprise)
# bloquent la connexion directe : il faut alors un serveur TURN (Metered, Cloudflare, coturn…).
# TURN_URL="turn:turn.exemple.com:3478,turns:turn.exemple.com:443?transport=tcp"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""

# --- Réglages avancés (facultatif) ---------------------------------------
# Mettre à "false" pour tester en mode production sur http (ex. téléphone sur le réseau local)
# COOKIE_SECURE="false"
# Active le service worker en développement
# NEXT_PUBLIC_ENABLE_SW="true"
