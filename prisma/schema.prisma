generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // connexion poolée Neon (-pooler)
  directUrl = env("DIRECT_URL")   // connexion directe, utilisée par db push / migrate
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO // message vocal
  VIDEO
  FILE
  POLL // sondage
  CALL // entrée du journal d'appels dans la discussion
  SYSTEM
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  about        String?   @default("Salut ! J'utilise Rodchat.")
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  participations    Participant[]
  messages          Message[]
  receipts          MessageReceipt[]
  pushSubscriptions PushSubscription[]
  callsMade         Call[]             @relation("CallCaller")
  callsReceived     Call[]             @relation("CallCallee")
  reactions         Reaction[]
  hiddenMessages    MessageHide[]
  starredMessages   StarredMessage[]
  connections       RealtimeConnection[]
  blocksGiven       Block[]              @relation("BlockGiven")
  statuses          Status[]
  statusViews       StatusView[]
  pollVotes         PollVote[]
  blocksReceived    Block[]              @relation("BlockReceived")
  // Réglages
  theme             String             @default("auto") // auto | light | dark
  readReceipts      Boolean            @default(true) // envoyer mes accusés de lecture
  lastSeenVisible   Boolean            @default(true) // montrer ma dernière connexion
  // Incrémenté pour déconnecter tous les appareils (changement de mot de passe, « déconnecter les autres »)
  sessionVersion    Int                @default(0)
  // Compte suspendu par un administrateur : connexion impossible
  suspendedAt       DateTime?
  suspendedReason   String?
  scheduledMessages ScheduledMessage[]
}

model Conversation {
  id            String   @id @default(cuid())
  isGroup       Boolean  @default(false)
  name          String? // groupes uniquement
  description   String? // groupes uniquement
  avatarUrl     String?
  // Messages éphémères : durée de vie des nouveaux messages, en secondes (null = désactivés)
  disappearingSeconds Int?
  // Lien d'invitation du groupe (null = aucun lien actif)
  inviteToken   String?  @unique
  // Pour un 1-à-1 : "idPetit:idGrand" -> évite les doublons de conversation
  directKey     String?  @unique
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants Participant[]
  messages     Message[]
  calls        Call[]
  scheduledMessages ScheduledMessage[]

  @@index([lastMessageAt])
}

model Participant {
  id             String          @id @default(cuid())
  userId         String
  conversationId String
  role           ParticipantRole @default(MEMBER)
  joinedAt       DateTime        @default(now())
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  // Réglages propres à chaque personne
  pinnedAt       DateTime?
  archivedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String?
  replyToId      String?
  // Id généré côté client : permet de renvoyer un message sans créer de doublon
  clientId       String?
  // Renseigné pour les messages de type CALL
  callId         String?     @unique
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime? // supprimé pour tous : il reste une trace « message supprimé »
  forwarded      Boolean     @default(false)
  // Personnes citées par « @pseudo » dans le texte (notifiées même si la discussion est en sourdine)
  mentionedIds String[] @default([])
  // Message épinglé en haut de la discussion (3 au maximum par discussion)
  pinnedAt     DateTime?
  pinnedById   String?
  // Réponse à un statut : extrait du statut cité
  statusQuote  String?
  // Aperçu du premier lien du message (titre, description, image), ajouté après l'envoi
  linkPreview    Json?
  // Messages éphémères : le message disparaît à cette date
  expiresAt      DateTime?

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?         @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]        @relation("Replies")
  receipts     MessageReceipt[]
  reactions    Reaction[]
  hides        MessageHide[]
  starredBy    StarredMessage[]
  attachment   Attachment?
  poll         Poll?
  call         Call?            @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

// Une réaction par personne et par message (comme WhatsApp) : en choisir une autre remplace la première
model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// « Supprimer pour moi » : le message reste pour les autres, il est masqué pour cette personne
model MessageHide {
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

// Messages favoris (étoile) : personnels à chaque personne
model StarredMessage {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt])
}

// Photos de profil et de groupe (petites images JPEG), stockées comme les autres fichiers
model AvatarImage {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

// Fichiers, photos, vidéos et messages vocaux : le contenu est stocké dans PostgreSQL (colonne bytea).
// Table séparée de Message pour que la lecture des discussions ne charge jamais les octets.
model Attachment {
  id         String   @id @default(cuid())
  messageId  String   @unique
  fileName   String
  mimeType   String
  size       Int
  durationMs Int? // messages vocaux
  width      Int? // images
  height     Int?
  data       Bytes
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// Journal des appels audio et vidéo (le flux, lui, passe directement entre les deux appareils)
model Call {
  id             String     @id @default(cuid())
  conversationId String
  callerId       String
  calleeId       String? // null pour un appel de groupe
  kind           CallKind
  status         CallStatus @default(RINGING)
  startedAt      DateTime   @default(now())
  answeredAt     DateTime?
  endedAt        DateTime?
  durationSec    Int?
  // Appel à deux : onglet / appareil de chaque côté (le temps réel ne tient plus rien en mémoire)
  callerConnId   String?
  calleeConnId   String?

  conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User                   @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User?                  @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  message      Message?
  participants GroupCallParticipant[]

  @@index([conversationId, startedAt])
  @@index([status])
}

// Présents dans un appel de groupe (avant : une Map en mémoire dans server.ts)
model GroupCallParticipant {
  callId   String
  userId   String
  connId   String
  joinedAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@id([callId, userId])
  @@index([userId])
}

// --- Temps réel sur Vercel + Neon, sans serveur WebSocket ---

// File d'événements : les routes API y écrivent, le flux /api/realtime/stream les relit et les envoie au navigateur.
// room = "user:<id>" | "conv:<id>" | "conn:<id>". Les lignes de plus de 10 minutes sont supprimées en continu.
model RealtimeEvent {
  id         Int      @id @default(autoincrement())
  room       String
  event      String
  payload    Json?
  // Appareil à ne pas notifier (celui qui est à l'origine de l'événement)
  exceptConn String?
  createdAt  DateTime @default(now())

  @@index([room, id])
  @@index([createdAt])
}

// Un onglet / appareil connecté. beatAt est rafraîchi toutes les ~8 s par son flux : plus de signe de vie = hors ligne.
model RealtimeConnection {
  id     String   @id
  userId String
  beatAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, beatAt])
}

// Accusés par destinataire : fonctionne pour les 1-à-1 comme pour les groupes
model MessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Compteurs du limiteur de débit partagé entre toutes les fonctions Vercel (login, inscription, envois…)
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Blocage : blockerId ne veut plus de messages ni d'appels de blockedId
model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// --- Statuts : texte ou photo, visibles 24 h par les personnes avec qui on a une discussion à deux ---

enum StatusType {
  TEXT
  IMAGE
}

model Status {
  id         String     @id @default(cuid())
  authorId   String
  type       StatusType
  // Texte du statut, ou légende de la photo
  text       String?
  // Numéro de la couleur de fond (voir src/lib/status-palette.ts), pour les statuts texte
  background Int        @default(0)
  createdAt  DateTime   @default(now())
  expiresAt  DateTime

  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  image  StatusImage?
  views  StatusView[]

  @@index([authorId, createdAt])
  @@index([expiresAt])
}

// Octets de la photo, à part pour ne jamais les charger dans les listes
model StatusImage {
  statusId String @id
  mimeType String
  size     Int
  width    Int?
  height   Int?
  data     Bytes

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
}

model StatusView {
  statusId String
  userId   String
  viewedAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([statusId, userId])
  @@index([userId])
}

// --- Messages programmés : envoyés à l'heure choisie par la première fonction qui passe après ---
model ScheduledMessage {
  id             String   @id @default(cuid())
  senderId       String
  conversationId String
  content        String
  sendAt         DateTime
  // Nombre de tentatives d'envoi (abandon au bout de 5)
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())

  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([sendAt])
  @@index([senderId, conversationId])
}

// --- Signalements (messages ou personnes), traités depuis /admin/reports ---
// Pas de clés étrangères : le signalement et son extrait survivent à la suppression du message ou du compte.
model Report {
  id              String    @id @default(cuid())
  reporterId      String
  targetUserId    String?
  targetName      String?
  messageId       String?
  conversationId  String?
  reason          String
  details         String?
  messageExcerpt  String?
  status          String    @default("OPEN") // OPEN | RESOLVED
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
}

// --- Administration ---

// Réglages de la plateforme modifiables depuis l'espace admin (inscription, annonce…)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Journal de toutes les actions des administrateurs (qui, quoi, sur qui, quand)
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String
  adminName  String
  action     String
  targetId   String?
  targetName String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// --- Sondages : une question, 2 à 6 réponses, un ou plusieurs choix. Les votes sont visibles par les membres. ---
model Poll {
  messageId String  @id
  question  String
  multiple  Boolean @default(false)

  message Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options PollOption[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  position Int

  poll  Poll       @relation(fields: [pollId], references: [messageId], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
}
